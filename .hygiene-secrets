# .hygiene-secrets — secret patterns that must never appear in ANY tracked file.
#
# Scanned by scripts/hygiene-check.sh across the whole tree (text files; binaries
# skipped). Format:  name :: Perl regex   (case-sensitive; add (?i) where needed).
# Blank lines and lines starting with # are ignored. This file itself is not
# scanned. Hits are reported as file:line + pattern name only — the matched
# value is never printed, so a real secret doesn't end up in CI logs.
#
# If a pattern flags legitimate text, narrow the regex (and note it in
# CLAUDE.md) — don't drop the pattern.

pem-private-key      :: -----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----
# sk_… : aeternity secret keys (aepp-sdk 14: "sk_" + base58check of 32 bytes), Stripe sk_live_/sk_test_, similar
sk-prefixed-key      :: (?<![A-Za-z0-9_])sk_[A-Za-z0-9_]{16,}
# legacy aeternity secret key: 64 bytes as 128 hex chars
hex-64-byte-secret   :: (?<![0-9a-fA-F])[0-9a-fA-F]{128}(?![0-9a-fA-F])
github-token         :: \b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}
github-fine-grained  :: \bgithub_pat_[A-Za-z0-9_]{20,}
# the variable name alone is fine in docs; an assigned value is not
railway-token        :: RAILWAY_(?:API_|PROJECT_)?TOKEN\s*[=:]\s*["']?[A-Za-z0-9-]{8,}
aws-access-key-id    :: \b(?:AKIA|ASIA)[0-9A-Z]{16}\b
aws-secret-key       :: (?i)aws_secret_access_key\s*[=:]\s*["']?[A-Za-z0-9/+=]{40}
token-in-url         :: (?i)[?&][a-z_]*token=[A-Za-z0-9._~%-]{8,}
